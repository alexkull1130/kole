public class Hello {
    public static main(args: string[]) -> void {
        print("Hello from kole!");
        for(i=0:5:+) {
            print("up", i);
        }
        for(i=5:0:-) {
            print("down", i);
        }
        for(row=0:2:+) {
            for(col=0:3:+) {
                print("cell", row, col);
            }
        }
    }
}
