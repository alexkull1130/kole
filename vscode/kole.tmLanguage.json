{
  "scopeName": "source.kole",
  "patterns": [
    { "name": "comment.line.double-slash.kole", "begin": "//", "end": "$" },
    { "name": "comment.block.kole", "begin": "/\\*", "end": "\\*/" },
    { "name": "string.quoted.double.kole", "begin": "\"", "end": "\"", "patterns": [{ "name": "constant.character.escape.kole", "match": "\\\\(?:u\\{[0-9a-fA-F]+\\}|.)" }] },
    { "name": "string.quoted.single.kole", "begin": "'", "end": "'", "patterns": [{ "name": "constant.character.escape.kole", "match": "\\\\(?:u\\{[0-9a-fA-F]+\\}|.)" }] },
    { "name": "keyword.control.kole", "match": "\\b(class|interface|extends|implements|abstract|override|public|private|static|enum|state|owns|belongsTo|requires|transitions|require|for|while|if|else|break|continue|return|new|package|import|try|catch|finally|throw|using|const|switch|case|default)\\b" },
    { "name": "variable.language.kole", "match": "\\b(me|super)\\b" },
    { "name": "storage.type.kole", "match": "\\b(byte|short|int|long|float|char|bool|string|void|List|Map|Set)\\b" },
    { "name": "constant.language.kole", "match": "\\b(true|false|null)\\b" },
    { "name": "constant.numeric.kole", "match": "\\b[0-9]+(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?[lLfF]?\\b" },
    { "name": "entity.name.function.kole", "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*\\()" },
    { "name": "keyword.operator.kole", "match": "->|[+*/%=!<>:&|?-]+" }
  ]
}
