{
  "Main class": {
    "prefix": "main",
    "body": [
      "class ${TM_FILENAME_BASE} {",
      "    static main(args: string[]) -> void {",
      "        $0",
      "    }",
      "}"
    ]
  },
  "Range loop": {
    "prefix": "for",
    "body": [
      "for(${1:i}=${2:0}:${3:10}:+) {",
      "    $0",
      "}"
    ]
  },
  "Method": {
    "prefix": "method",
    "body": [
      "${1:name}(${2}) -> ${3:void} {",
      "    $0",
      "}"
    ]
  },
  "Scoped resource": {
    "prefix": "using",
    "body": [
      "using(${1:file}: TextFile = File.open(${2:path}, \"${3:r}\")) {",
      "    $0",
      "}"
    ]
  },
  "Try catch": {
    "prefix": "try",
    "body": [
      "try {",
      "    $1",
      "} catch(error: Error) {",
      "    print(error.message);",
      "}"
    ]
  },
  "Generic class": {
    "prefix": "generic",
    "body": [
      "class ${1:Box}<A> {",
      "    private item: A;",
      "    ${1:Box}(item: A) { me.item = item; }",
      "    get() -> A { return item; }",
      "}"
    ]
  },
  "Construct object": {
    "prefix": "construct",
    "body": [
      "${1:name}: ${2:Type}(${3});"
    ]
  },
  "Construct list": {
    "prefix": "list",
    "body": [
      "${1:names}: List<${2:string}>();"
    ]
  },
  "Collection loop": {
    "prefix": "foreach",
    "body": [
      "for(${1:item}: ${2:items}) {",
      "    $0",
      "}"
    ]
  },
  "Switch expression": {
    "prefix": "switch",
    "body": [
      "switch(${1:value}) {",
      "    case ${2:1} -> ${3:result};",
      "    default -> ${4:fallback};",
      "}"
    ]
  },
  "Const binding": {
    "prefix": "const",
    "body": [
      "const ${1:name}: ${2:int} = ${3:0};"
    ]
  },
  "Construct map": {
    "prefix": "map",
    "body": [
      "${1:values}: Map<${2:string},${3:int}>();"
    ]
  },
  "Construct set": {
    "prefix": "set",
    "body": [
      "${1:values}: Set<${2:string}>();"
    ]
  }
}
